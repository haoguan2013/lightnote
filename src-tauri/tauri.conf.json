{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "轻记",
  "version": "1.11.1",
  "identifier": "com.lightnotes.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx serve -l 1420 .",
    "beforeBuildCommand": "node scripts/prepare-dist.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻记 · 四码笔记",
        "url": "/notes.html",
        "width": 960,
        "height": 640,
        "minWidth": 860,
        "minHeight": 540,
        "resizable": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
